  "note": "Exact-match, context-scoped UI edits only. OpenCC s2twp runs before this stage. Full dialogue QA is separate.",
  "ui_rules": [
    {
      "id": "start-menu-save",
      "path": "engine/menus/start_menu.asm",
      "from": "記錄@",
      "to": "儲存@",
      "reason": "Save command is an action. Taiwan game UI uses 儲存 rather than 記錄 for the control.",
      "source_url": "https://support.nintendo.com/hk/switch2/mastery/accessibility/index.html"
    },
    {
      "id": "main-menu-new-game",
      "path": "engine/menus/main_menu.asm",
      "from": "從頭開始@",
      "to": "新遊戲@",
      "reason": "Concise and natural title-menu label for starting a new save.",
      "source_url": "https://tw.portal-pokemon.com/special/pika_vee/tc/howtoplay/"
    },
    {
      "id": "options-print-density",
      "path": "engine/menus/options_menu.asm",
      "from": "打印濃度",
      "to": "列印濃度",
      "reason": "Taiwan Traditional Chinese calls printing 列印.",
      "source_url": "https://support.nintendo.com/hk/switch2/mastery/accessibility/index.html"
    },
    {
      "id": "stats-ot-short-label",
      "path": "engine/pokemon/stats_screen.asm",
      "from": "初訓家/@",
      "to": "訓練家/@",
      "reason": "OT = Original Trainer; current stats layout starts owner name at x14, 6 tiles after x8 label. 原訓練家 needs 8 tiles and would overlap name; 訓練家 is 6 tiles and remains recognizable in context.",
      "source_url": "https://wiki.52poke.com/zh-hant/初訓家"
    },
    {
