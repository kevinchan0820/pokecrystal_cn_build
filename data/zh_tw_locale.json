      "to": "調整遊戲設定",
      "reason": "Describe actual options without awkward wording",
      "source_url": "https://en.wikibooks.org/wiki/Pok%C3%A9mon_Crystal/Options"
    },
    {
      "id": "start-menu-options-description-2",
      "path": "engine/menus/start_menu.asm",
      "from": "進行調整@",
      "to": "與操作選項@",
      "reason": "Second line completes option description",
      "source_url": "https://en.wikibooks.org/wiki/Pok%C3%A9mon_Crystal/Options"
    },
    {
      "id": "main-menu-options",
      "path": "engine/menus/main_menu.asm",
      "from": "重新設置@",
      "to": "設定@",
      "reason": "This entry opens options, not a reset",
      "source_url": "https://github.com/pret/pokecrystal/blob/master/engine/menus/main_menu.asm"
    }
