    {
      "id": "start-menu-save-description-2",
      "path": "engine/menus/start_menu.asm",
      "from": "先記錄狀態@",
      "to": "冒險進度@",
      "reason": "Save persists adventure progress",
      "source_url": "https://en.wikibooks.org/wiki/Pok%C3%A9mon_Crystal"
    },
    {
      "id": "start-menu-options-description-1",
      "path": "engine/menus/start_menu.asm",
